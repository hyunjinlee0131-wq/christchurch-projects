---
import Base from "../../layouts/Base.astro";
import ParkMap from "../../components/ParkMap.astro";
import Feedback from "../../components/Feedback.astro";
import data from "../../data/best_park/parks.json";

const votingConfigured = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

const base = import.meta.env.BASE_URL;
const parks = data.parks;
const top = parks[0];
const n = parks.length;
const TOP_N = 10;
---
<Base
  title="Best Park in Christchurch — ranked by data, and by you"
  description={`All ${n} Christchurch parks ranked by playgrounds, seats, barbecues, water, sport, dog areas, trees and size. #1: ${top.name}.`}
  dataPulledAt={data.data_pulled_at}
  ogImage={`og/parks/${top.slug}.png`}
>
  <div class="wrap">
    <h1>Best Park in Christchurch</h1>
    <p class="lede">The #1 park by the data is <a href={`${base}parks/${top.slug}/`}><strong>{top.name}</strong></a>.
      Ranked from {n} parks using council data on what's actually in them.</p>


    <section aria-labelledby="list-h">
      <h2 id="list-h">Ranking</h2>
    <details class="card controls">
      <summary><h2 id="w-h">What matters to you?</h2> <span class="muted">Re-rank every park for you</span></summary>
      <p class="muted">Slide to re-rank every park for you. 0 = don't care, 3 = very important.</p>
      <div class="sliders">
        {data.factors.map((f) => (
          <label class="slider">
            <span>{f.label}</span>
            <input type="range" min="0" max="3" step="0.5" value={String((data.weights as Record<string, number>)[f.key])}
                   data-key={f.key} aria-describedby="w-h" />
            <output>{(data.weights as Record<string, number>)[f.key]}</output>
          </label>
        ))}
      </div>
      <div class="actions">
        <button type="button" id="reset">Reset to default</button>
        <button type="button" id="near-me">Parks near me</button>
      </div>
      <p id="status" class="muted" role="status" aria-live="polite"></p>
    </details>
      <div class="table-wrap">
        <table id="rank-table" class="collapsed">
          <thead>
            <tr><th scope="col">Rank</th><th scope="col">Park</th><th scope="col">Score</th>
                <th scope="col" class="col-you" hidden>Your rank</th><th scope="col" class="col-dist" hidden>Distance</th>
                <th scope="col" class="col-type">Type</th><th scope="col" class="col-area">Size</th></tr>
          </thead>
          <tbody>
            {parks.map((p) => (
              <tr data-id={p.id} data-lat={p.lat} data-lon={p.lon}>
                <td class="rank">{p.rank}</td>
                <td><a href={`${base}parks/${p.slug}/`}>{p.name}</a></td>
                <td><span class="bar" style={`--w:${p.score}`} aria-hidden="true"></span> <span class="score">{p.score}</span></td>
                <td class="col-you" hidden></td>
                <td class="col-dist" hidden></td>
                <td class="col-type muted">{p.type}</td>
                <td class="col-area muted">{p.area_ha.toFixed(1)} ha</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <button type="button" id="show-all" aria-controls="rank-table" aria-expanded="false">Show all {n} parks</button>
      <noscript><style>#rank-table.collapsed tbody tr:nth-child(n+11) { display: table-row; } #show-all { display: none; }</style></noscript>
      <Feedback project="best_park" itemId="ranking" question="Was this ranking useful?" />
    </section>

    <section class="card people" aria-labelledby="people-h">
      <h2 id="people-h">People's Choice</h2>
      <p class="muted">The data can't measure everything. Vote for the parks you love on each park's page — this list is
        ranked by votes only, shown next to (never mixed into) the data score.</p>
      <div id="people" data-min="20">
        <p class="muted" id="people-msg">{votingConfigured ? "Loading votes…" : "Voting opens soon."}</p>
        <ol id="podium" class="podium" aria-label="People's Choice top 3" hidden></ol>
        <ol id="runners-up" class="runners-up" start="4" aria-label="People's Choice 4th and 5th" hidden></ol>
        <p id="aerial-credit" class="muted small" hidden>Aerial imagery: <a href="https://basemaps.linz.govt.nz/">LINZ</a> (CC BY 4.0).
          Park outlines: Christchurch City Council.</p>
      </div>
      <div id="dvp" hidden>
        <h3>Data vs People</h3>
        <div class="dvp-grid">
          <div><h4>Underrated by the data</h4><ol id="dvp-under"></ol></div>
          <div><h4>Loved less than the data says</h4><ol id="dvp-over"></ol></div>
        </div>
      </div>
    </section>

    <ParkMap />

    <section class="card method" aria-labelledby="how-h">
      <h2 id="how-h">How this was calculated</h2>
      <p>For every park we count what the council records inside it (or within 20 m of its edge):</p>
      <ul>
        {data.factors.map((f) => <li>{f.label} — weight {(data.weights as Record<string, number>)[f.key]}</li>)}
      </ul>
      <p>Each count becomes a percentile against all parks (having none scores 0). The score is the weighted
        average of the percentiles, from 0 to 100. Tree cover is trees per hectare, capped at 200. It only counts trees
        the council records individually, so forests and large natural areas (like Bottle Lake Forest) score low on trees.</p>
      <p>Included: local, community, sports, regional, garden &amp; heritage and red-zone parks of at least 0.1 ha.
        Utility land, cemeteries and the plant nursery are left out.</p>
      <p><strong>Not counted:</strong> toilets (not in the council's open data), shade, views, cafés and how busy a park is —
        that's what the votes are for.</p>
    </section>
  </div>
</Base>

<script>
  import { allZero, rankParks, type Weights } from "../../lib/scoring";
  import { track } from "../../lib/analytics";

  const base = import.meta.env.BASE_URL;
  const table = document.getElementById("rank-table") as HTMLTableElement;
  const tbody = table.tBodies[0];
  const rows = new Map<string, HTMLTableRowElement>();
  for (const r of Array.from(tbody.rows)) rows.set(r.dataset.id!, r);
  const status = document.getElementById("status")!;
  const sliders = Array.from(document.querySelectorAll<HTMLInputElement>(".slider input"));
  const showAll = document.getElementById("show-all") as HTMLButtonElement;

  type Park = { id: string; pct: Record<string, number>; area_ha: number; rank: number; lat: number; lon: number };
  let cache: { weights: Weights; parks: Park[] } | null = null;
  const load = async () => (cache ??= await (await fetch(`${base}data/best_park/parks.json`)).json());

  const setCols = (cls: string, on: boolean) =>
    table.querySelectorAll<HTMLElement>(`.${cls}`).forEach((c) => (c.hidden = !on));

  const order = (ids: string[]) => {
    const frag = document.createDocumentFragment();
    for (const id of ids) frag.append(rows.get(id)!);
    tbody.append(frag);
  };

  const weightsNow = (): Weights => Object.fromEntries(sliders.map((s) => [s.dataset.key!, Number(s.value)]));

  let timer: number | undefined;
  const rerank = async () => {
    const d = await load();
    const w = weightsNow();
    const isDefault = sliders.every((s) => Number(s.value) === d.weights[s.dataset.key!]);
    if (allZero(w)) {
      status.textContent = "Pick at least one thing you care about — showing the default ranking.";
      setCols("col-you", false);
      order([...d.parks].sort((a, b) => a.rank - b.rank).map((p) => p.id));
      return;
    }
    const ranked = rankParks(d.parks, w, d.weights);
    for (const p of ranked) rows.get(p.id)!.querySelector(".col-you")!.textContent = String(p.personalRank);
    setCols("col-you", !isDefault);
    setCols("col-dist", false);
    order(ranked.map((p) => p.id));
    status.textContent = isDefault ? "" : `Re-ranked for you. Your #1: ${rows.get(ranked[0].id)!.cells[1].textContent}.`;
    clearTimeout(timer);
    timer = window.setTimeout(() => track("reweight", Object.fromEntries(Object.entries(w).map(([k, v]) => [k, v]))), 1500);
  };

  for (const s of sliders) {
    s.addEventListener("input", () => {
      (s.nextElementSibling as HTMLOutputElement).value = s.value;
      rerank();
    });
  }

  document.getElementById("reset")!.addEventListener("click", async () => {
    const d = await load();
    for (const s of sliders) {
      s.value = String(d.weights[s.dataset.key!]);
      (s.nextElementSibling as HTMLOutputElement).value = s.value;
    }
    rerank();
  });

  document.getElementById("near-me")!.addEventListener("click", () => {
    if (!navigator.geolocation) { status.textContent = "Your browser can't share location."; return; }
    status.textContent = "Finding your location…";
    navigator.geolocation.getCurrentPosition(async (pos) => {
      const d = await load();
      const { latitude: la, longitude: lo } = pos.coords;
      const R = 6371, rad = Math.PI / 180;
      const dist = (p: Park) => {
        const dLa = (p.lat - la) * rad, dLo = (p.lon - lo) * rad;
        const a = Math.sin(dLa / 2) ** 2 + Math.cos(la * rad) * Math.cos(p.lat * rad) * Math.sin(dLo / 2) ** 2;
        return 2 * R * Math.asin(Math.sqrt(a));
      };
      const near = d.parks.map((p) => ({ id: p.id, km: dist(p) })).sort((a, b) => a.km - b.km);
      for (const p of near) rows.get(p.id)!.querySelector(".col-dist")!.textContent = `${p.km.toFixed(1)} km`;
      setCols("col-dist", true);
      order(near.map((p) => p.id));
      status.textContent = "Sorted by distance from you. Your location is not stored or sent anywhere.";
      track("near_me");
    }, () => { status.textContent = "Location permission was denied — the ranking still works without it."; },
    { timeout: 10000 });
  });

  // People's Choice: votes only, beside the data ranking. Top 3 on a podium, #4–5 as smaller cards,
  // each with an aerial photo of the park; the top 3 also get medal markers on the map.
  import("../../lib/votes").then(async ({ getCounts, votingEnabled }) => {
    if (!votingEnabled()) return;
    const { dataVsPeople, peopleRanking, podium } = await import("../../lib/people");
    const msg = document.getElementById("people-msg")!;
    const [counts, d] = await Promise.all([getCounts(), load()]);
    if (!counts) { msg.textContent = "Votes couldn't load right now — try again later."; return; }
    type Named = Park & { name: string; slug: string };
    const named = d.parks as Named[];
    const people = peopleRanking(named, counts);
    if (!people.length) { msg.textContent = "No votes yet — open any park and be the first."; return; }
    msg.remove();

    const { top3, runnersUp } = podium(people);
    const PLACES = ["gold", "silver", "bronze"];
    const MEDALS = ["🥇", "🥈", "🥉"];
    const plural = (n: number) => `${n} vote${n === 1 ? "" : "s"}`;
    const card = (p: (typeof people)[number], i: number, big: boolean) => {
      const li = document.createElement("li");
      li.className = big ? `podium-card ${PLACES[i]}` : "runner-card";
      const aerial = document.createElement("div");
      aerial.className = "aerial";
      aerial.dataset.id = p.id;
      aerial.setAttribute("role", "img");
      aerial.setAttribute("aria-label", `Aerial photo of ${p.name}`);
      const body = document.createElement("div");
      body.className = "card-body";
      const place = document.createElement("span");
      place.className = "place";
      place.textContent = big ? `${MEDALS[i]} #${i + 1}` : `#${i + 1}`;
      const a = document.createElement("a");
      a.href = `${base}parks/${p.slug}/`;
      a.className = "park-name";
      a.textContent = p.name;
      const meta = document.createElement("span");
      meta.className = "meta";
      meta.textContent = `${plural(p.votes)} · data rank #${p.rank}`;
      body.append(place, a, meta);
      li.append(aerial, body);
      return li;
    };
    const podiumEl = document.getElementById("podium")!;
    const runnersEl = document.getElementById("runners-up")!;
    podiumEl.replaceChildren(...top3.map((p, i) => card(p, i, true)));
    runnersEl.replaceChildren(...runnersUp.map((p, i) => card(p, i + 3, false)));
    podiumEl.hidden = false;
    runnersEl.hidden = runnersUp.length === 0;
    document.getElementById("aerial-credit")!.hidden = false;

    // Medal markers on the map (the map may finish loading before or after this).
    const top = top3.map((p) => ({ id: p.id, name: p.name, slug: p.slug, lon: p.lon, lat: p.lat, votes: p.votes }));
    (window as unknown as { __peoplesTop?: typeof top }).__peoplesTop = top;
    window.dispatchEvent(new CustomEvent("peoples-top", { detail: top }));

    // Aerial photos, drawn when the section is about to scroll into view.
    const drawAerials = async () => {
      try {
        const [{ loadMapLibre, linzAerialTiles }, { bboxOf }, geo] = await Promise.all([
          import("../../lib/maplibre"),
          import("../../lib/geo"),
          fetch(`${base}data/best_park/parks.geojson`).then((r) => r.json()),
        ]);
        const maplibregl = await loadMapLibre();
        const byId = new Map<string, any>(geo.features.map((f: any) => [String(f.properties.id), f]));
        for (const el of document.querySelectorAll<HTMLElement>(".people .aerial")) {
          const feature = byId.get(el.dataset.id!);
          if (!feature) continue;
          const map = new maplibregl.Map({
            container: el, interactive: false, attributionControl: false, fadeDuration: 0,
            style: {
              version: 8,
              sources: {
                aerial: { type: "raster", tiles: [linzAerialTiles()], tileSize: 256, maxzoom: 20 },
                park: { type: "geojson", data: feature },
              },
              layers: [
                { id: "aerial", type: "raster", source: "aerial" },
                { id: "park-glow", type: "line", source: "park", paint: { "line-color": "#000", "line-width": 6, "line-opacity": 0.35 } },
                { id: "park-line", type: "line", source: "park", paint: { "line-color": "#ffd34d", "line-width": 3 } },
              ],
            },
          });
          map.fitBounds(bboxOf(feature.geometry), { padding: 18, maxZoom: 18, duration: 0 });
        }
      } catch (err) {
        console.error("people's choice aerials failed", err);
      }
    };
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); drawAerials(); }
    }, { rootMargin: "300px" }).observe(document.querySelector(".people")!);

    // Data vs People
    const li = (p: { slug: string; name: string }, extra: string) => {
      const el = document.createElement("li");
      const a = document.createElement("a");
      a.href = `${base}parks/${p.slug}/`;
      a.textContent = p.name;
      el.append(a, document.createTextNode(` — ${extra}`));
      return el;
    };
    const min = Number(document.getElementById("people")!.dataset.min);
    const dvp = dataVsPeople(named, counts, min);
    const box = document.getElementById("dvp")!;
    if (!dvp) {
      const note = document.createElement("p");
      note.className = "muted";
      note.textContent = `Data vs People appears after ${min} votes — be one of the first.`;
      box.before(note);
      return;
    }
    document.getElementById("dvp-under")!.replaceChildren(...dvp.underrated.map((p) => li(p, `${p.gap} place${p.gap === 1 ? "" : "s"} higher with people`)));
    document.getElementById("dvp-over")!.replaceChildren(...dvp.overrated.map((p) => li(p, `${-p.gap} place${p.gap === -1 ? "" : "s"} lower with people`)));
    box.hidden = false;
  });

  showAll.addEventListener("click", () => {
    const expanded = table.classList.toggle("collapsed") === false;
    showAll.setAttribute("aria-expanded", String(expanded));
    showAll.textContent = expanded ? "Show top 10" : `Show all ${rows.size} parks`;
  });
</script>

<style>
  .lede { font-size: 1.15rem; }
  .controls { margin: 0 0 1rem; }
  .controls summary { cursor: pointer; display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; min-height: 44px; }
  .controls summary h2 { display: inline; font-size: 1.15rem; margin: 0; }
  .sliders { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.5rem 1.5rem; }
  .slider { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0 0.5rem; }
  .slider span { grid-column: 1 / -1; font-size: 0.95rem; }
  .slider input { width: 100%; min-height: 32px; accent-color: var(--accent); }
  .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: var(--radius); }
  th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  th { font-size: 0.85rem; color: var(--muted); }
  .rank { font-weight: 700; width: 3.5rem; }
  #rank-table.collapsed tbody tr:nth-child(n+11) { display: none; }
  .bar { display: inline-block; height: 8px; width: calc(var(--w) * 0.6px); max-width: 60px; background: var(--accent); border-radius: 4px; }
  #show-all { margin-top: 0.75rem; }
  .method, .people { margin-top: 2rem; }
  /* People's Choice podium */
  .podium, .runners-up { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 1rem; }
  .podium { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-items: end; }
  .runners-up { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .podium :global(.podium-card), .runners-up :global(.runner-card) {
    border-radius: 14px; overflow: hidden; background: var(--surface); border: 1px solid var(--border);
  }
  .podium :global(.podium-card) { border-width: 3px; box-shadow: 0 8px 24px rgb(0 0 0 / 0.12); }
  .podium :global(.aerial) { height: 200px; }
  .podium :global(.gold .aerial) { height: 240px; }
  .runners-up :global(.runner-card) { display: grid; grid-template-columns: 104px 1fr; align-items: center; }
  .runners-up :global(.aerial) { height: 104px; }
  .people :global(.aerial) { background: #2b3532; }
  .people :global(.card-body) { padding: 0.75rem 1rem 1rem; display: grid; gap: 0.15rem; }
  .people :global(.place) { font-weight: 800; font-size: 0.95rem; letter-spacing: 0.02em; }
  .podium :global(.place) { font-size: 1.25rem; }
  .people :global(.park-name) { font-weight: 700; font-size: 1.05rem; color: var(--text); }
  .podium :global(.park-name) { font-size: 1.3rem; }
  .people :global(.meta) { color: var(--muted); font-size: 0.9rem; }
  .podium :global(.gold) { border-color: #d4a017; background: linear-gradient(180deg, var(--surface) 55%, rgb(212 160 23 / 0.16)); }
  .podium :global(.silver) { border-color: #9aa3ad; background: linear-gradient(180deg, var(--surface) 55%, rgb(154 163 173 / 0.18)); }
  .podium :global(.bronze) { border-color: #b0703c; background: linear-gradient(180deg, var(--surface) 55%, rgb(176 112 60 / 0.16)); }
  @media (min-width: 760px) {
    /* classic podium order: 2nd, 1st, 3rd */
    .podium { grid-template-columns: 1fr 1.15fr 1fr; }
    .podium :global(.silver) { order: 1; }
    .podium :global(.gold) { order: 2; }
    .podium :global(.bronze) { order: 3; }
  }
  .small { font-size: 0.85rem; }
  .dvp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  @media (max-width: 600px) { .col-type, .col-area { display: none; } }
</style>
